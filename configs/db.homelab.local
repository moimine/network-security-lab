; Zone direct pour 10.114.22.0/24 (homelab.local)
$TTL    604800
@       IN      SOA     dns-server.homelab.local. hostmaster.homelab.local. (
                              3         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@               IN      NS      dns-server.homelab.local.
dns-server      IN      A       10.114.22.3
dns		IN	CNAME	dns-server
dhcp-server 	IN	A	10.114.22.2
dhcp		IN	CNAME	dhcp-server
router		IN	A	10.114.22.1
