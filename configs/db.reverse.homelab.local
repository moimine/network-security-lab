; Zone inverse pour 10.114.22.0/24 (homelab.local)
$TTL    604800
@       IN      SOA     dns-server.homelab.local. hostmaster.homelab.local. (
                              3         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@               IN      NS      dns-server.homelab.local.
1     		IN      PTR     router.homelab.local.
2 		IN	PTR	dhcp-server.homelab.local.
3		IN	PTR	dns-server.homelab.local.


